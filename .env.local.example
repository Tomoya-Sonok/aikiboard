# AikiBoard 環境変数
#
# このルート 1 ファイルだけで frontend / backend 両方の env を管理する。
#   cp .env.local.example .env.local
# で .env.local を作成し、値を埋める。.env.local は .gitignore 済み(コミット厳禁)。
#
# 読み込まれ方:
#   - frontend: next.config.mjs が起動時に ../.env.local を読み込む
#   - backend : dev スクリプトが `cd .. && dotenv -e .env.local` で読み込む
#
# ───────────────────────────────────────────────────────────────
# 通常はローカル Supabase 用の値(下記)で開発する。
# ANON / SERVICE キーは `cd backend && pnpm exec supabase status` で確認して埋める。
# 本番に繋ぐ場合は各値を Supabase Dashboard / 本番ドメインに差し替える。
# ───────────────────────────────────────────────────────────────

## Frontend(Next.js)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase status の Publishable key>
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787
NEXT_SERVER_API_URL=http://127.0.0.1:8787
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

## Backend(Hono)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=<supabase status の Secret key>
SUPABASE_ANON_KEY=<supabase status の Publishable key>

# Phase 1 認証(authMiddleware の access_token 検証)。
# 本線は Supabase の JWKS(非対称 ES256)で検証するため、backend は上の SUPABASE_URL が
# あればよく、SUPABASE_JWT_SECRET は通常不要。
# 下記は legacy HS256 署名(従来の共有 secret)で署名されたトークン向けのフォールバック。
# ローカル既定値は `pnpm exec supabase status` の JWT secret。本番が HS256 の場合のみ
# Dashboard → Settings → API → JWT Secret を Cloudflare Workers Secret に登録:
#   cd backend && pnpm exec wrangler secret put SUPABASE_JWT_SECRET
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# お知らせのメール一斉送信(Resend)。要件 4.2「メールでも通知する」。
# - 本番は Cloudflare Workers Secret に登録: cd backend && pnpm exec wrangler secret put RESEND_API_KEY
# - RESEND_FROM_EMAIL は wrangler.toml の [vars] に本番値を置く(下記はローカル用)。
# - 未設定ならメール送信は警告ログを残してスキップされ、公開自体は成功する。
# - ローカル検証: aiki-board.com のドメイン認証が済むまでは Resend の制約で
#   onboarding@resend.dev 発の自分宛メールのみ送れる(seed のメールを自分のアドレスにする)。
RESEND_API_KEY=<Resend の API キー(任意。未設定ならスキップ)>
RESEND_FROM_EMAIL=onboarding@resend.dev
