# AikiBoard 環境変数サンプル
#
# このファイルをコピーして .env.local を作成し、用途に応じて値を設定する:
#   cp .env.local.example .env.local
#
# ローカル開発(ローカル Supabase コンテナ)では「ローカル Supabase 用」を有効化する。
# 本番値は Vercel / Cloudflare Workers の環境変数に登録済み(ローカルで本番 DB に繋ぐ必要は通常ない)。

# ───────────────────────────────────────────────────────────────
# 【本番 Supabase 用】(AikiNote と同一プロジェクト)
# Supabase Dashboard → Project Settings → API / Database から取得。
# ローカルで本番に繋ぐ場合のみ、下記を有効化して値を埋める。
# ───────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<本番 anon / publishable key>
# SUPABASE_SERVICE_ROLE_KEY=<本番 service_role / secret key>
# SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_API_URL=https://api.aiki-board.com
# NEXT_PUBLIC_APP_URL=https://aiki-board.com

# ───────────────────────────────────────────────────────────────
# 【ローカル Supabase 用】(cd backend && pnpm exec supabase start の固定値)
# 値は `cd backend && pnpm exec supabase status` で確認できる。
# ───────────────────────────────────────────────────────────────
# ANON / SERVICE キーは `cd backend && pnpm exec supabase status` で取得して貼り付ける
# (supabase ローカルの共通固定値だが、secret scanning 回避のためサンプルには実値を書かない)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase status の Publishable key>
SUPABASE_SERVICE_ROLE_KEY=<supabase status の Secret key>
SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
